DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ergon_db
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
